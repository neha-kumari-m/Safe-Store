<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <style>
      body {
        background-image: url(./images/background-pic.jpg);
        background-position: center;
        background-size: cover;
      }
      #container {
        height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        font-family: Arial, Helvetica, sans-serif;
      }
      #content {
        background-color: rgba(255, 255, 255, 0.195);
        border: 2px solid green;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
        border-radius: 10px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        padding: 20px 30px;
        gap: 5px;
        width: 400px;
      }
      .file {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 20px;
      }
    </style>
  </head>
  <body>
    <div id="container">
      <div id="content">
        <% files.forEach((file) => { %>
        <div class="file">
          <h2><%= file.originalname %></h2>
          <a href="/download/<%= file._id %>">Download</a>
        </div>
        <%}); %>
        <button onclick="history.back()">Go Back</button>
      </div>
    </div>
  </body>
</html>
